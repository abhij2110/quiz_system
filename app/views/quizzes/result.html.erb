<div class="container" style="max-width: 800px; margin: 40px auto;">

  <h1 class="text-center" style="font-weight: 600;">
    Results for: <%= @quiz.title %>
  </h1>

  <h2 class="text-center" style="margin-bottom: 30px;">
    Score: <%= @score %> / <%= @quiz.questions.count %>
  </h2>

  <% @results.each_with_index do |r, index| %>
    <div style="
      background: #fff;
      border: 1px solid #ddd;
      padding: 20px;
      border-radius: 10px;
      margin-bottom: 20px;
    ">
      
      <p style="font-size: 18px; font-weight: 600;">
        <%= index + 1 %>. <%= r["question"] %>
      </p>

      <% if r["correct"] %>
        <p style="color: green; font-size: 16px;">
          ✅ Correct — Your answer: <strong><%= r["user_answer"] %></strong>
        </p>
      <% else %>
        <p style="color: red; font-size: 16px;">
          ❌ Wrong — Your answer: <strong><%= r["user_answer"].presence || "No answer" %></strong>
        </p>

        <p style="font-size: 15px; color: #555;">
          Correct answer: <strong><%= r["correct_answer"] %></strong>
        </p>
      <% end %>
      
    </div>
  <% end %>

  <div class="text-center" style="margin-top: 30px;">
    <a href="/" style="
      padding: 12px 24px;
      background: #007bff;
      color: white;
      font-size: 18px;
      border-radius: 8px;
      text-decoration: none;
    ">
      Back to Quiz List
    </a>
  </div>

</div>
