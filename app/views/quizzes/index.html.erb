<div class="container" style="max-width: 700px; margin: 40px auto;">
  <h1 class="text-center mb-4" style="font-weight: 600;">Available Quizzes</h1>

  <% if @quizzes.any? %>
    <div class="list-group">
      <% @quizzes.each do |quiz| %>
        <a href="<%= quiz_path(quiz) %>"
           class="list-group-item list-group-item-action"
           style="
             border: 1px solid #ddd;
             border-radius: 8px;
             padding: 16px 20px;
             font-size: 18px;
             margin-bottom: 12px;
             text-decoration: none;
             color: #333;
             transition: background 0.2s, transform 0.15s;
           "
           onmouseover="this.style.background='#f8f9fa'; this.style.transform='scale(1.01)'"
           onmouseout="this.style.background='white'; this.style.transform='scale(1)'">
          <%= quiz.title %>

          <span style="float: right; color: #888; font-size: 14px;">
            Start →
          </span>
        </a>
      <% end %>
    </div>
  <% else %>
    <p class="text-center" style="font-size: 18px; color: #777;">
      No quizzes available yet.
    </p>
  <% end %>
</div>
